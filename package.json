{
  "name": "loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.cjs",
    "setup:auth": "tsx scripts/setup-auth.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.9",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.0.0",
    "otplib": "^12.0.1",
    "prisma": "^6.12.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.1.1"
  }
}
