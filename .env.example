# Copiar a .env y completar antes de ejecutar la aplicación o Compose.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# En Compose, usar el host postgres y las mismas credenciales que POSTGRES_*.
# Codificar como URL los caracteres especiales del usuario y de la contraseña.
# Ejemplo de formato: postgresql://USUARIO:PASSWORD@postgres:5432/BASE?schema=public
DATABASE_URL=
CORS_ORIGIN=
OWNER_USERNAME=
# Usar comillas simples en .env para conservar los signos $ del hash bcrypt.
OWNER_PASSWORD_HASH=''
JWT_SECRET=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
NEXT_PUBLIC_LOOP_API_URL=http://127.0.0.1:3000
WEB_PORT=3001
GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PLACES_DAILY_REQUEST_LIMIT=1000
